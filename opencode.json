{
  "$schema": "https://opencode.ai",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx.cmd", "-y", "chrome-devtools-mcp@latest", "--no--usage-statistics"]
      },
      "coderabbit": {
        "type": "local",
        "command": ["npx.cmd", "-y", "coderabbitai-mcp@latest"]
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
